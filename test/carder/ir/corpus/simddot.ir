module @carder@wasm@dot8 {
  numerics true
  memory none
  export "dot8" = @f0
  export "addsat" = @f1
  export "lanes" = @f2
  func @f0 (%p0:i32) -> (i32) {
    let (%v0) = values (v128.const 0x00000000000000000000000000000000)
    let (%v2) = simd i16x8.splat (%p0)
    let (%v3) = simd i32x4.dot_i16x8_s (v128.const 0x01000200030004000500060007000800, %v2)
    let (%v4) = simd i32x4.extract_lane.0 (%v3)
    let (%v5) = simd i32x4.extract_lane.1 (%v3)
    let (%v6) = num i.add.32 (%v4, %v5)
    let (%v7) = simd i32x4.extract_lane.2 (%v3)
    let (%v8) = simd i32x4.extract_lane.3 (%v3)
    let (%v9) = num i.add.32 (%v7, %v8)
    let (%v10) = num i.add.32 (%v6, %v9)
    values (%v10)
  }
  func @f1 (%p0:i32) -> (i32) {
    let (%v1) = simd i16x8.splat (%p0)
    let (%v2) = simd i16x8.add_sat_s (%v1, v128.const 0x30753075307530753075307530753075)
    let (%v3) = simd i16x8.extract_lane_s.0 (%v2)
    values (%v3)
  }
  func @f2 (%p0:i32) -> (i32) {
    let (%v1) = simd i32x4.splat (%p0)
    let (%v2) = simd i32x4.mul (%v1, v128.const 0x01000000020000000300000004000000)
    let (%v3) = simd i32x4.max_s (%v2, v128.const 0x00000000000000006400000000000000)
    let (%v4) = simd i32x4.extract_lane.2 (%v3)
    values (%v4)
  }
}

