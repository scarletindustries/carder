module @carder@wasm@call_unary {
  numerics true
  memory none
  table @t0 min 3
  export "call_unary" = @f2
  export "call_binary" = @f3
  elem @t0 (values (i32.const 0)) [@f0, @f1]
  func @f0 (%p0:i32) -> (i32) {
    let (%v1) = num i.add.32 (%p0, i32.const 1)
    values (%v1)
  }
  func @f1 (%p0:i32) -> (i32) {
    let (%v1) = num i.mul.32 (%p0, i32.const 2)
    values (%v1)
  }
  func @f2 (%p0:i32, %p1:i32) -> (i32) {
    let (%v1) = call_indirect @t0 [%p0] : (i32) -> (i32) (%p1)
    values (%v1)
  }
  func @f3 (%p0:i32, %p1:i32) -> (i32) {
    let (%v1) = call_indirect @t0 [%p0] : (i32, i32) -> (i32) (%p1, %p1)
    values (%v1)
  }
}

