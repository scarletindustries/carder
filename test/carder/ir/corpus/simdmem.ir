module @carder@wasm@st_ld {
  numerics true
  memory (min 1)
  export "st_ld" = @f0
  export "splat" = @f1
  export "lane" = @f2
  export "oob" = @f3
  func @f0 (%p0:i32) -> (i32) {
    let (%v1) = simd i32x4.splat (%p0)
    let () = simd.store i32.const 0 %v1 offset=0
    let (%v2) = simd.load v128 i32.const 0 offset=0
    let (%v3) = simd i32x4.extract_lane.3 (%v2)
    values (%v3)
  }
  func @f1 (%p0:i32) -> (i32) {
    let () = mem.store 4 i32.const 16 %p0 offset=0
    let (%v1) = simd.load splat 32 i32.const 16 offset=0
    let (%v2) = simd i32x4.extract_lane.1 (%v1)
    values (%v2)
  }
  func @f2 (%p0:i32) -> (i32) {
    let (%v1) = simd i32x4.splat (%p0)
    let () = simd.store_lane 32 i32.const 32 offset=0 lane=2 %v1
    let (%v2) = mem.load i32 4 i32.const 32 offset=0
    values (%v2)
  }
  func @f3 () -> (i32) {
    let (%v1) = simd.load v128 i32.const 65530 offset=0
    let (%v2) = simd i32x4.extract_lane.0 (%v1)
    values (%v2)
  }
}

