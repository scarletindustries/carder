module @carder@wasm@divs {
  numerics true
  memory none
  export "divs" = @f0
  export "divu" = @f1
  export "rems" = @f2
  export "shl" = @f3
  func @f0 (%p0:i32, %p1:i32) -> (i32) {
    let (%v1) = num i.div_s.32 (%p0, %p1)
    values (%v1)
  }
  func @f1 (%p0:i32, %p1:i32) -> (i32) {
    let (%v1) = num i.div_u.32 (%p0, %p1)
    values (%v1)
  }
  func @f2 (%p0:i32, %p1:i32) -> (i32) {
    let (%v1) = num i.rem_s.32 (%p0, %p1)
    values (%v1)
  }
  func @f3 (%p0:i32, %p1:i32) -> (i32) {
    let (%v1) = num i.shl.32 (%p0, %p1)
    values (%v1)
  }
}

