# macOS Finder metadata
.DS_Store

# Phase-15 tier-N C NIF build artifacts — anchored to the in-tree build location ONLY, so a future
# committed priv/*.so from the packaging follow-on is NOT silently ignored (the follow-on git add -f's
# if these ever widen). The test-time build compiles under $TMPDIR (outside the repo) and is never staged.
/c_src/*.so
/c_src/*.dylib
/c_src/*.o

# Source-language conformance suites belong to the frontends, not to the backend. The WebAssembly
# spec suite lives in the scribbler repo; test262 lives with the JS frontend. Neither should ever
# be checked out here — this entry stops a stray `git add .` from committing gigabytes.
/test262/
